# Anthropic API key — pegue uma em https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Postgres — Neon recomenda 2 URLs separadas para serverless (Vercel):
#  - DATABASE_URL: URL do POOLER (com "-pooler" no host) — usada pelo app em runtime.
#  - DIRECT_URL:   URL DIRETA (sem "-pooler") — usada por `prisma migrate`.
# Exemplo Neon (substitua pelos seus valores reais):
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require&pgbouncer=true&connect_timeout=10"
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
